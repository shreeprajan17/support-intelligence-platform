# PostgreSQL — individual variables used by Docker Compose to initialise the container
POSTGRES_DB=support_intelligence
POSTGRES_USER=sip_user
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_PORT=5433

# SQLAlchemy connection string — used by the application
# Use localhost when running the app outside Docker (e.g. uvicorn on your machine)
# Use the service name 'db' when running the app inside Docker Compose
DATABASE_URL=postgresql+psycopg://sip_user:change-me-before-use@localhost:5433/support_intelligence

# Application
APP_ENV=development
SECRET_KEY=change-me-before-use
